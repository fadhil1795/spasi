DATABASE_URL="mysql://root:password@localhost:3306/spasi_db"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# --- EMAIL NOTIFICATION (NODEMAILER) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="email.anda@gmail.com"
SMTP_PASS="password_aplikasi_gmail_anda"

# --- WHATSAPP NOTIFICATION GATEWAY (UNIVERSAL) ---
# Pilihan Provider: EVOLUTION | FONNTE | GENERIC
WHATSAPP_GATEWAY_PROVIDER="EVOLUTION"

# 1. Jika menggunakan EVOLUTION API:
WHATSAPP_API_URL="http://localhost:8080"
WHATSAPP_API_KEY="YOUR_GLOBAL_API_KEY"
WHATSAPP_INSTANCE_NAME="SPASI_WA"

# 2. Jika menggunakan FONNTE:
# WHATSAPP_API_URL="https://api.fonnte.com/send"
# WHATSAPP_API_KEY="YOUR_FONNTE_TOKEN"

# 3. Jika menggunakan GENERIC HTTP POST (Custom Gateway):
# WHATSAPP_API_URL="https://your-custom-gateway.com/send"
# WHATSAPP_API_KEY="optional_bearer_token"
# Kustomisasi payload JSON untuk gateway generic (opsional, ganti {{phone}} dan {{message}} secara dinamis):
# WHATSAPP_GENERIC_PAYLOAD_TEMPLATE="{\"target\":\"{{phone}}\",\"message\":\"{{message}}\",\"countryCode\":\"62\"}"
# Kustomisasi header HTTP tambahan dalam bentuk format string JSON (opsional):
# WHATSAPP_GENERIC_HEADERS="{\"x-api-key\":\"secret-token\",\"Custom-Header\":\"Value\"}"
